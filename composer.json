{
    "name": "zkr/nexusphp",
    "description": "NexusPHP - A standalone, dependency-free PHP 8.2+ framework",
    "type": "library",
    "license": "MIT",
    "homepage": "https://gak722.github.io/nexusphp/",
    "support": {
        "docs": "https://gak722.github.io/nexusphp/",
        "source": "https://github.com/gak722/nexusphp"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12",
        "vimeo/psalm": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\": "framework/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/TestRunner.php",
        "test:coverage": "php tests/TestRunner.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}