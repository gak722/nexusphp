# ==============================================================================
# NexusPHP Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure values suitable for your environment.
#
#   cp .env.example .env
#
# All variables defined here are parsed by Nexus\Support\Env and mapped to
# framework configuration repositories (config/*.php).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & General Settings
# ------------------------------------------------------------------------------
# APP_NAME: Display name of the application.
APP_NAME="NexusPHP Application"

# APP_ENV: Application lifecycle environment (production, development, testing, local, staging).
APP_ENV=development

# APP_DEBUG: Enables debug mode and detailed error stack traces (true/false).
# WARNING: Always set to false in production environments.
APP_DEBUG=true

# APP_URL: Base URL for generating absolute links and asset URLs.
APP_URL=http://localhost:8000

# APP_KEY: 32-byte secret key used for Libsodium symmetric encryption & JWT signing.
# MUST be set and at least 16 characters long (e.g., base64 encoded or 32+ char string).
APP_KEY=base64:c2VjcmV0a2V5bmV4dXNwaHAxMjM0NTY3ODkwMTIzNDU2

# LOG_PATH: Optional custom path for the application log file.
# Leave commented out or null to use the default path (storage/logs/app.log).
#LOG_PATH=storage/logs/app.log


# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# DB_CONNECTION: Default database driver (mysql, pgsql, sqlite).
DB_CONNECTION=mysql

# MySQL / PostgreSQL Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexus
DB_USERNAME=root
DB_PASSWORD=

# SQLite Configuration (Used when DB_CONNECTION=sqlite)
# For SQLite, set DB_DATABASE to the absolute or relative path of the database file.
#DB_CONNECTION=sqlite
#DB_DATABASE=storage/database.sqlite


# ------------------------------------------------------------------------------
# 3. Cache Subsystem
# ------------------------------------------------------------------------------
# CACHE_DRIVER: Default cache driver (file, redis, apcu).
CACHE_DRIVER=file

# CACHE_LEGACY_UNSERIALIZE: Enables legacy unserialize() fallback with safe parameters
# during cache format migration (true/false). Default is false for maximum security.
CACHE_LEGACY_UNSERIALIZE=false


# ------------------------------------------------------------------------------
# 4. Queue Subsystem
# ------------------------------------------------------------------------------
# QUEUE_CONNECTION: Default queue driver for background job processing (database, redis).
QUEUE_CONNECTION=database


# ------------------------------------------------------------------------------
# 5. Real-Time Event Broadcasting
# ------------------------------------------------------------------------------
# BROADCAST_DRIVER: Driver used by Nexus\Events\BroadcastManager (redis).
BROADCAST_DRIVER=redis


# ------------------------------------------------------------------------------
# 6. Redis Infrastructure
# ------------------------------------------------------------------------------
# Redis connection parameters shared across Cache, Queue, and Broadcasting.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379


# ------------------------------------------------------------------------------
# 7. Mail Subsystem
# ------------------------------------------------------------------------------
# MAIL_MAILER: Mail delivery transport driver (smtp, log, array).
MAIL_MAILER=smtp

# SMTP Server Credentials
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls

# Global "From" Address Metadata
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Custom log file path when MAIL_MAILER=log (defaults to storage/logs/mail.log if null)
#MAIL_LOG_PATH=storage/logs/mail.log


# ------------------------------------------------------------------------------
# 8. Security & JWT Configuration
# ------------------------------------------------------------------------------
# JWT_LEEWAY_SECONDS: Clock skew leeway in seconds when validating JWT claims (exp, nbf, iat).
JWT_LEEWAY_SECONDS=0


# ------------------------------------------------------------------------------
# 9. HTTP & Response Security Tuning
# ------------------------------------------------------------------------------
# HTTP_HEADER_MAX_LENGTH: Maximum byte length allowed for individual HTTP header values.
HTTP_HEADER_MAX_LENGTH=4096
